    <!-- permissions -->
    <string name="permissions">Permissions</string>
    <string name="permissions_none_detail">None asked. What Android allows, and how to change it</string>
    <string name="permissions_intro">Dispatch asks for no permission. It works with what Android gives every app, and you can check each line below in Settings.</string>
    <string name="permissions_on_this_phone">On this phone</string>
    <string name="permissions_hint">Read again each time you come back. Turning something on or off in Settings changes nothing in Dispatch, because it needs none of it.</string>
    <string name="permissions_without">What works without a permission</string>
    <string name="permissions_share_menu">Appearing in the share menu: any app can offer to receive what you share.</string>
    <string name="permissions_visibility">Seeing the apps that can receive a share, and only those. Not your full list of apps, so there is no switch for it.</string>
    <string name="access_permissions">Permissions</string>
    <string name="access_permissions_why">Dispatch requests none: no internet, no storage, no contacts. Save uses the folder picker instead.</string>
    <string name="access_notifications">Notifications</string>
    <string name="access_notifications_why">Not used. Dispatch never sends a notification, whatever this is set to.</string>
    <string name="access_battery">Battery</string>
    <string name="access_battery_why">Not needed. Dispatch only runs while its screen is open, so Optimized is right. Settings shows it under App battery usage.</string>
    <string name="access_none">None</string>
