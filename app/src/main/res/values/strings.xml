    <!-- what leaves your device -->
    <string name="what_leaves">What leaves your device</string>
    <string name="leaves_nothing">Nothing. This app has no internet access. Dispatch only hands what you share to the app you pick.</string>
    <string name="leaves_when_you_choose">Only when you choose it</string>
    <string name="leaves_send">Tapping an app hands it what you shared, and nothing else.</string>
    <string name="leaves_copy">Copy and Copy image put it on the clipboard. The app you paste into reads it.</string>
    <string name="leaves_save">Save writes it into the folder you pick.</string>
    <string name="leaves_stays">Stays on this device</string>
    <string name="stays_choices">Your pinned apps, in your order, and your hidden apps.</string>
    <string name="stays_last">The Remember last used switch. Only while it is on, the last app you used: one entry, replaced each time.</string>
    <string name="stays_images">Private copies of the last three images you copied, so pasting keeps working.</string>
    <string name="stays_backup">Excluded from backups and phone to phone transfers. No counters, no history.</string>

